DATABASE_URL="postgresql://usuario:password@localhost:5432/turnero?schema=public"

# Clave para cifrar las credenciales de MercadoPago (AES-256-GCM, 32 bytes en hex)
ENCRYPTION_KEY=""

# URL pública con la que se arman los links que van por mail (cancelar, reprogramar)
# y la notification_url de las preferencias de MercadoPago.
# OJO: es la que ve el usuario, NO la interna de la plataforma. Durante la migración
# la app va a estar detrás de un proxy, y si acá ponés la URL interna, a los clientes
# les llegan mails con un dominio que no reconocen.
PUBLIC_BASE_URL="https://turnos.reviturnos.com.ar"

# Token del cron que dispara /api/tareas. Sin este valor el endpoint queda
# cerrado (401): es preferible que las tareas no corran a que corra cualquiera.
#   openssl rand -hex 32
TAREAS_TOKEN=""

# Poner en 1 para que no se envíe ni un correo. Es lo que usan las
# verificaciones: las plantas tienen SMTP real cargado y probar contra ellas
# manda mails de verdad a direcciones inventadas.
CORREO_DESACTIVADO=""
